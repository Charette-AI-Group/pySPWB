# Local working folders, deliberately untracked.
#   .data/        demo datasets, regenerated by tools/make_demo_data.py
#   .screenshots/ manual images, regenerated by tools/make_manual_images.py
# Both hold generated output only - nothing here is a source of truth, so a
# clean checkout simply re-creates them.
/.data/
/.screenshots/

# the report written by "spwb --selftest" / tools/build_standalone.py
selftest.txt
